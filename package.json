{
  "name": "gemma-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "predev": "npx tsx scripts/check-db.ts",
    "dev": "npx tsx scripts/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "npm --prefix packages/database run db:generate",
    "prisma:push": "npm --prefix packages/database run db:push",
    "prisma:seed": "npm --prefix packages/database run db:seed"
  },
  "dependencies": {
    "@mission-os/database": "*",
    "@mission-os/shared": "*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/qrcode": "^1.5.6",
    "lucide-react": "^0.471.0",
    "next": "15.5.20",
    "openai": "^6.49.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.7.0",
    "recharts": "^2.15.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
